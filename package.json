{
  "name": "no-code",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A visual, drag-and-drop no-code builder for websites and small web apps.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
